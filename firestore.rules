rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pañol vive bajo su clave. Solo entra quien conoce la clave
    // (nadie puede listar los pañoles existentes).
    match /panoles/{clave}/{document=**} {
      allow read, write: if request.auth != null && clave.size() >= 12;
    }
  }
}
